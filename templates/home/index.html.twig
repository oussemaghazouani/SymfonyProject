{% extends 'base.html.twig' %}

{% block title %}Bienvenue sur SaaS Client{% endblock %}

{% block body %}
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-gradient-primary">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="text-center mb-5">
                <h1 class="display-4 text-white fw-bold mb-4">
                    <i class="fas fa-rocket me-3"></i>
                    Bienvenue sur SaaS Client
                </h1>
                <p class="lead text-white-50 mb-5">
                    La plateforme qui connecte les clients aux meilleurs prestataires de services
                </p>
            </div>

            <div class="row g-4">
                <!-- Client Registration -->
                <div class="col-md-6">
                    <div class="card shadow-lg border-0 h-100">
                        <div class="card-body p-5 text-center">
                            <div class="text-primary mb-4">
                                <i class="fas fa-user-tie fa-4x"></i>
                            </div>
                            <h3 class="card-title text-primary mb-3">Je suis un Client</h3>
                            <p class="card-text text-muted mb-4">
                                Trouvez les meilleurs prestataires pour vos projets. 
                                Accédez à une large gamme de services professionnels.
                            </p>
                            <div class="d-grid gap-2">
                                <a href="{{ path('auth_client_register') }}" class="btn btn-primary btn-lg">
                                    <i class="fas fa-user-plus me-2"></i>
                                    S'inscrire comme Client
                                </a>
                                <a href="{{ path('auth_login') }}" class="btn btn-outline-primary">
                                    <i class="fas fa-sign-in-alt me-2"></i>
                                    Se connecter
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Service Provider Registration -->
                <div class="col-md-6">
                    <div class="card shadow-lg border-0 h-100">
                        <div class="card-body p-5 text-center">
                            <div class="text-success mb-4">
                                <i class="fas fa-briefcase fa-4x"></i>
                            </div>
                            <h3 class="card-title text-success mb-3">Je suis un Prestataire</h3>
                            <p class="card-text text-muted mb-4">
                                Proposez vos services et développez votre clientèle. 
                                Rejoignez notre réseau de prestataires qualifiés.
                            </p>
                            <div class="d-grid gap-2">
                                <a href="{{ path('auth_provider_register') }}" class="btn btn-success btn-lg">
                                    <i class="fas fa-briefcase me-2"></i>
                                    S'inscrire comme Prestataire
                                </a>
                                <a href="{{ path('auth_login') }}" class="btn btn-outline-success">
                                    <i class="fas fa-sign-in-alt me-2"></i>
                                    Se connecter
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Features Section -->
            <div class="row mt-5">
                <div class="col-12">
                    <div class="card shadow border-0">
                        <div class="card-body p-5">
                            <h2 class="text-center mb-5">Pourquoi choisir SaaS Client ?</h2>
                            <div class="row g-4">
                                <div class="col-md-4 text-center">
                                    <div class="text-info mb-3">
                                        <i class="fas fa-shield-alt fa-3x"></i>
                                    </div>
                                    <h5>Sécurisé</h5>
                                    <p class="text-muted">
                                        Vérification d'email et de téléphone pour tous les utilisateurs.
                                        Vos données sont protégées.
                                    </p>
                                </div>
                                <div class="col-md-4 text-center">
                                    <div class="text-warning mb-3">
                                        <i class="fas fa-star fa-3x"></i>
                                    </div>
                                    <h5>Qualité garantie</h5>
                                    <p class="text-muted">
                                        Prestataires vérifiés et évalués par la communauté.
                                        Service client réactif.
                                    </p>
                                </div>
                                <div class="col-md-4 text-center">
                                    <div class="text-success mb-3">
                                        <i class="fas fa-bolt fa-3x"></i>
                                    </div>
                                    <h5>Rapide et efficace</h5>
                                    <p class="text-muted">
                                        Trouvez rapidement le prestataire idéal.
                                        Gestion simplifiée de vos projets.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Call to Action -->
            <div class="text-center mt-5">
                <p class="text-white-50">
                    Déjà inscrit ? 
                    <a href="{{ path('auth_login') }}" class="text-white fw-bold text-decoration-none">
                        Connectez-vous ici
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
.bg-gradient-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}
</style>
{% endblock %}