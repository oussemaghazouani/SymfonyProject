{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - SaaS Client{% endblock %}

{% block body %}
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white text-center py-4">
                    <h1 class="h3 mb-0">
                        <i class="fas fa-key me-2"></i>
                        Mot de passe oublié
                    </h1>
                    <p class="mb-0 text-light">Réinitialisez votre mot de passe</p>
                </div>
                
                <div class="card-body p-4">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                    
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    <div class="text-center mb-4">
                        <i class="fas fa-lock fa-3x text-danger mb-3"></i>
                        <p class="text-muted">
                            Saisissez votre adresse email pour recevoir un code de réinitialisation.
                        </p>
                    </div>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    
                    <div class="mb-4">
                        <label for="{{ form.email.vars.id }}" class="form-label fw-bold">
                            <i class="fas fa-envelope me-1"></i>{{ form.email.vars.label }}
                        </label>
                        {{ form_widget(form.email, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'votre.email@exemple.com'}}) }}
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="fas fa-paper-plane me-2"></i>
                            Envoyer le code
                        </button>
                    </div>

                    {{ form_end(form) }}

                    <hr class="my-4">
                    
                    <div class="text-center">
                        <a href="{{ path('auth_login') }}" class="btn btn-link">
                            <i class="fas fa-arrow-left me-2"></i>
                            Retour à la connexion
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}