{% extends 'base.html.twig' %}

{% block title %}Connexion - SaaS Client{% endblock %}

{% block body %}
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-info text-white text-center py-4">
                    <h1 class="h3 mb-0">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        Connexion
                    </h1>
                    <p class="mb-0 text-light">Accédez à votre compte</p>
                </div>
                
                <div class="card-body p-4">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                    
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    
                    <div class="mb-3">
                        <label for="{{ form.identifiant.vars.id }}" class="form-label fw-bold">
                            <i class="fas fa-user me-1"></i>{{ form.identifiant.vars.label }}
                        </label>
                        {{ form_widget(form.identifiant, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Votre identifiant ou email'}}) }}
                        {{ form_errors(form.identifiant) }}
                    </div>

                    <div class="mb-4">
                        <label for="{{ form.password.vars.id }}" class="form-label fw-bold">
                            <i class="fas fa-lock me-1"></i>{{ form.password.vars.label }}
                        </label>
                        {{ form_widget(form.password, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Votre mot de passe'}}) }}
                        {{ form_errors(form.password) }}
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-info btn-lg">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Se connecter
                        </button>
                    </div>

                    {{ form_end(form) }}

                    <div class="text-center">
                        <a href="{{ path('auth_forgot_password') }}" class="btn btn-link">
                            <i class="fas fa-question-circle me-1"></i>
                            Mot de passe oublié ?
                        </a>
                    </div>

                    <hr class="my-4">
                    
                    <div class="text-center">
                        <p class="mb-3">Pas encore de compte ?</p>
                        <div class="d-grid gap-2">
                            <a href="{{ path('auth_client_register') }}" class="btn btn-primary">
                                <i class="fas fa-user-plus me-2"></i>
                                Inscription Client
                            </a>
                            <a href="{{ path('auth_provider_register') }}" class="btn btn-success">
                                <i class="fas fa-briefcase me-2"></i>
                                Inscription Prestataire
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}