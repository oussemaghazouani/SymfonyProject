{% extends 'base.html.twig' %}

{% block title %}Vérification Code - SaaS Client{% endblock %}

{% block body %}
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white text-center py-4">
                    <h1 class="h3 mb-0">
                        <i class="fas fa-shield-alt me-2"></i>
                        Code de vérification
                    </h1>
                    <p class="mb-0 text-light">Vérifiez votre identité</p>
                </div>
                
                <div class="card-body p-4">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                    
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    <div class="text-center mb-4">
                        <i class="fas fa-envelope fa-3x text-danger mb-3"></i>
                        <p class="text-muted">
                            Saisissez le code de réinitialisation reçu par email.
                        </p>
                    </div>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    
                    <div class="mb-4">
                        <label for="{{ form.code.vars.id }}" class="form-label fw-bold text-center d-block">
                            <i class="fas fa-key me-1"></i>{{ form.code.vars.label }}
                        </label>
                        {{ form_widget(form.code, {'attr': {'class': 'form-control form-control-lg text-center', 'style': 'font-size: 1.5rem; letter-spacing: 0.5rem;'}}) }}
                        {{ form_errors(form.code) }}
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="fas fa-check me-2"></i>
                            Vérifier le code
                        </button>
                    </div>

                    {{ form_end(form) }}

                    <div class="text-center">
                        <p class="text-muted mb-2">Code expiré ou invalide ?</p>
                        <a href="{{ path('auth_forgot_password') }}" class="btn btn-outline-danger">
                            <i class="fas fa-redo me-2"></i>
                            Demander un nouveau code
                        </a>
                    </div>

                    <hr class="my-4">
                    
                    <div class="text-center">
                        <a href="{{ path('auth_login') }}" class="btn btn-link">
                            <i class="fas fa-arrow-left me-2"></i>
                            Retour à la connexion
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Auto-format the verification code input
document.getElementById('{{ form.code.vars.id }}').addEventListener('input', function(e) {
    let value = e.target.value.replace(/\D/g, '');
    if (value.length > 6) {
        value = value.slice(0, 6);
    }
    e.target.value = value;
});
</script>
{% endblock %}