{% extends 'base.html.twig' %}

{% block title %}Vérification Email - SaaS Client{% endblock %}

{% block body %}
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-warning text-dark text-center py-4">
                    <h1 class="h3 mb-0">
                        <i class="fas fa-envelope-open-text me-2"></i>
                        Vérification Email
                    </h1>
                    <p class="mb-0">Code de vérification requis</p>
                </div>
                
                <div class="card-body p-4">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                    
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    <div class="text-center mb-4">
                        <i class="fas fa-envelope fa-3x text-warning mb-3"></i>
                        <p class="text-muted">
                            Un code de vérification à 6 chiffres a été envoyé à :
                        </p>
                        <p class="fw-bold text-primary">{{ user_email }}</p>
                    </div>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    
                    <div class="mb-4">
                        <label for="{{ form.code.vars.id }}" class="form-label fw-bold text-center d-block">
                            <i class="fas fa-key me-1"></i>{{ form.code.vars.label }}
                        </label>
                        {{ form_widget(form.code, {'attr': {'class': 'form-control form-control-lg text-center', 'style': 'font-size: 1.5rem; letter-spacing: 0.5rem;'}}) }}
                        {{ form_errors(form.code) }}
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-warning btn-lg">
                            <i class="fas fa-check me-2"></i>
                            Vérifier le code
                        </button>
                    </div>

                    {{ form_end(form) }}

                    <div class="text-center">
                        <p class="text-muted mb-2">Vous n'avez pas reçu le code ?</p>
                        <button id="resend-btn" class="btn btn-outline-warning" onclick="resendCode()">
                            <i class="fas fa-paper-plane me-2"></i>
                            Renvoyer le code
                        </button>
                        <div id="countdown" class="text-muted mt-2" style="display: none;">
                            Nouveau code disponible dans <span id="timer">60</span> secondes
                        </div>
                    </div>

                    <hr class="my-4">
                    
                    <div class="text-center">
                        <a href="{{ path('auth_client_register') }}" class="btn btn-link">
                            <i class="fas fa-arrow-left me-2"></i>
                            Retour à l'inscription
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let countdown = 0;
let timer = null;

function startCountdown() {
    countdown = 60;
    document.getElementById('resend-btn').disabled = true;
    document.getElementById('countdown').style.display = 'block';
    
    timer = setInterval(function() {
        countdown--;
        document.getElementById('timer').textContent = countdown;
        
        if (countdown <= 0) {
            clearInterval(timer);
            document.getElementById('resend-btn').disabled = false;
            document.getElementById('countdown').style.display = 'none';
        }
    }, 1000);
}

function resendCode() {
    fetch('{{ path('auth_resend_verification') }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Code de vérification renvoyé avec succès!');
            startCountdown();
        } else {
            alert('Erreur: ' + data.message);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Une erreur s\'est produite. Veuillez réessayer.');
    });
}

// Auto-format the verification code input
document.getElementById('{{ form.code.vars.id }}').addEventListener('input', function(e) {
    let value = e.target.value.replace(/\D/g, '');
    if (value.length > 6) {
        value = value.slice(0, 6);
    }
    e.target.value = value;
});
</script>
{% endblock %}