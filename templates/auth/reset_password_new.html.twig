{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - SaaS Client{% endblock %}

{% block body %}
<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center py-4">
                    <h1 class="h3 mb-0">
                        <i class="fas fa-lock me-2"></i>
                        Nouveau mot de passe
                    </h1>
                    <p class="mb-0 text-light">Choisissez un mot de passe sécurisé</p>
                </div>
                
                <div class="card-body p-4">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                    
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    <div class="text-center mb-4">
                        <i class="fas fa-key fa-3x text-success mb-3"></i>
                        <p class="text-muted">
                            Créez votre nouveau mot de passe pour finaliser la réinitialisation.
                        </p>
                    </div>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                    
                    <div class="mb-3">
                        <label for="{{ form.password.first.vars.id }}" class="form-label fw-bold">
                            <i class="fas fa-lock me-1"></i>Nouveau mot de passe
                        </label>
                        {{ form_widget(form.password.first, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Minimum 6 caractères'}}) }}
                        {{ form_errors(form.password.first) }}
                    </div>

                    <div class="mb-4">
                        <label for="{{ form.password.second.vars.id }}" class="form-label fw-bold">
                            <i class="fas fa-lock me-1"></i>Confirmer le mot de passe
                        </label>
                        {{ form_widget(form.password.second, {'attr': {'class': 'form-control form-control-lg', 'placeholder': 'Répétez le mot de passe'}}) }}
                        {{ form_errors(form.password.second) }}
                    </div>

                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Conseils pour un mot de passe sécurisé :</strong>
                        <ul class="mb-0 mt-2">
                            <li>Au moins 6 caractères</li>
                            <li>Combinez lettres, chiffres et symboles</li>
                            <li>Évitez les informations personnelles</li>
                        </ul>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fas fa-save me-2"></i>
                            Réinitialiser le mot de passe
                        </button>
                    </div>

                    {{ form_end(form) }}

                    <hr class="my-4">
                    
                    <div class="text-center">
                        <a href="{{ path('auth_login') }}" class="btn btn-link">
                            <i class="fas fa-arrow-left me-2"></i>
                            Retour à la connexion
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}